# ============================================================
#  Personal Site · 环境变量模板
#  本地开发：cp .env.example .env  然后填值
#  完整说明见 docs/01-architecture.md §11
#
#  ⚠ 为什么用 .env 而不是 .env.local：
#    Next.js 两者都读，但 Prisma CLI 只读 .env。本地统一用一个文件，
#    免得为了一个环境变量再引入 dotenv 之类的依赖。
# ============================================================

# ---- 运行时 ----
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 数据库 ----
# 本地开发（docker compose up -d db）
DATABASE_URL="postgresql://dev:dev@localhost:5432/personal_site?schema=public"
# 生产（Neon / Supabase）
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# 隔离测试库，必须以 _test 结尾；绝不使用开发/生产库执行集成测试
TEST_DATABASE_URL="postgresql://dev:dev@localhost:5432/personal_site_test?schema=public"

# ---- 鉴权 ----
# ⚠ 生产必须替换：openssl rand -base64 48
JWT_SECRET=dev-only-secret-please-replace-me-with-a-real-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 仅当站点只能由可信反向代理访问，且代理覆盖客户端IP头时启用
TRUST_PROXY=false

# ---- 文件存储 ----
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- 邮件（二期）----
RESEND_API_KEY=
MAIL_FROM=

# ---- 可选集成 ----
NEXT_PUBLIC_ANALYTICS_ID=
# 独立发布调度Bearer密钥，至少32位；不能复用JWT_SECRET
REVALIDATE_SECRET=

# ---- 首次 seed 时创建的管理员 ----
# ⚠ 首次登录后请立即修改密码
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123
SEED_ADMIN_NAME=Puly
