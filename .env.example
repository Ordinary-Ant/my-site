# ============================================================
#  Personal Site · 环境变量模板
#  复制为 .env.local 后填写：cp .env.example .env.local
#  完整说明见 docs/01-architecture.md §11
# ============================================================

# ---- 运行时 ----
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 数据库 ----
# 本地开发（docker compose up -d db）
DATABASE_URL="postgresql://dev:dev@localhost:5432/personal_site?schema=public"
# 生产（Neon / Supabase）
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# SQLite 降级（不推荐，见 docs/02-data-model.md §7）
# DATABASE_URL="file:./dev.db"

# ---- 鉴权 ----
# ⚠ 生产必须替换：openssl rand -base64 48
JWT_SECRET=dev-only-secret-please-replace-me-with-a-real-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- 文件存储 ----
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- 邮件（二期）----
RESEND_API_KEY=
MAIL_FROM=

# ---- 可选集成 ----
NEXT_PUBLIC_ANALYTICS_ID=
REVALIDATE_SECRET=

# ---- 首次 seed 时创建的管理员 ----
# ⚠ 首次登录后请立即修改密码
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123
SEED_ADMIN_NAME=Puly
